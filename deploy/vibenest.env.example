# DESIGN WORKSHEET ONLY. Pilot rejected; not a deployable/authenticated setup.
# No secrets are present. Do not copy into a live deployment as-is.
# A future same-container proxy would use this private listener.
WASTEBIN_ADDRESS_PORT=127.0.0.1:8088
WASTEBIN_DATABASE_PATH=/data/state.db
TMPDIR=/data
# Set the real HTTPS origin explicitly; no public URL has been assigned.
WASTEBIN_BASE_URL=
# Required persistent secret, >=64 UTF-8 bytes. Generic 48-char autofill is invalid.
WASTEBIN_SIGNING_KEY=
# Set a persistent instance-specific value; this does not fix per-entry salts.
WASTEBIN_PASSWORD_SALT=
# Proposed bounds only; not benchmarked or accepted on Free.
WASTEBIN_MAX_BODY_SIZE=16384
WASTEBIN_CACHE_SIZE=4
WASTEBIN_HTTP_TIMEOUT=5
WASTEBIN_TITLE=wastebin
RUST_LOG=info
